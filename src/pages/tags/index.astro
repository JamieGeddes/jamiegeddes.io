---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags } from "../../utils/posts";

const tags = await getAllTags();
---

<BaseLayout
  title="Tags"
  description="Browse posts on jamiegeddes.io by topic."
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Tags</p>
      <h1 class="page-title">Browse by topic</h1>
      <p class="page-lede">{tags.length} topics across the blog.</p>
    </header>

    <ul class="tag-cloud">
      {
        tags.map(({ tag, slug, posts }) => (
          <li>
            <a href={`/tags/${slug}/`} class="tag-chip">
              <span class="tag-name">{tag}</span>
              <span class="tag-count">{posts.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .page-title {
    font-size: clamp(2rem, 5.5vw, 2.85rem);
    font-weight: 700;
    letter-spacing: -0.022em;
    margin-top: 0.7rem;
  }
  .page-lede {
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.45rem 0.55rem 0.45rem 0.95rem;
    background: var(--bg-raised);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .tag-chip:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .tag-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.98rem;
  }
  .tag-chip:hover .tag-name { color: var(--accent); }
  .tag-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    background: var(--code-bg);
    border-radius: 999px;
    min-width: 1.5rem;
    height: 1.5rem;
    display: inline-grid;
    place-items: center;
  }
</style>
