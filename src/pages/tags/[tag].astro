---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListItem from "../../components/PostListItem.astro";
import { getAllTags } from "../../utils/posts";

export const getStaticPaths = (async () => {
  const tags = await getAllTags();
  return tags.map(({ tag, slug, posts }) => ({
    params: { tag: slug },
    props: { tag, posts },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`Tag: ${tag}`}
  description={`Posts tagged “${tag}” on jamiegeddes.io.`}
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow"><a href="/tags" class="tags-back">Tags</a> /</p>
      <h1 class="page-title">{tag}</h1>
      <p class="page-lede">
        {posts.length}
        {posts.length === 1 ? "post" : "posts"} tagged with this topic.
      </p>
    </header>

    <section class="post-list" aria-label={`Posts tagged ${tag}`}>
      {posts.map((post) => <PostListItem post={post} />)}
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .tags-back {
    color: var(--ink-faint);
    transition: color 0.15s ease;
  }
  .tags-back:hover { color: var(--accent); }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 2.85rem);
    font-weight: 700;
    letter-spacing: -0.022em;
    margin-top: 0.7rem;
  }
  .page-lede {
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }
</style>
